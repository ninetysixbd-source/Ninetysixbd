# Database - Supabase Connection Pooler
DATABASE_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations
DIRECT_URL="postgresql://postgres.[USERNAME]:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Next Auth
# Run: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000" # Set to production URL in Vercel

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Google OAuth
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Node Environment
NODE_ENV=development

# UploadThing (for product image storage)
UPLOADTHING_TOKEN="your-uploadthing-token"

# ─── Tracking / Analytics ───────────────────────────────────
# Facebook / Meta Pixel (also covers Instagram)
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
NEXT_PUBLIC_META_PIXEL_ID=""

# TikTok Pixel
TIKTOK_PIXEL_ID=""
TIKTOK_ACCESS_TOKEN=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# Site URL (used in tracking context)
NEXT_PUBLIC_SITE_URL="https://ninetysixbd.com"
